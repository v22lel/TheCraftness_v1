#file: ./elevator/load
/scoreboard objectives add escapemap_desert_elevator dummy
/scoreboard players set #running escapemap_desert_elevator 0
/scoreboard players set #tick_divisor escapemap_desert_elevator 2
/scoreboard players set #current_station escapemap_desert_elevator 0

#file: ./elevator/reset
/scoreboard players set #running escapemap_desert_elevator 0
/function escapemap:puzzles/desert/elevator/despawn_entities
/scoreboard players set #current_station escapemap_desert_elevator 0
/function escapemap:puzzles/desert/elevator/place_station_0_blocks
/function escapemap:puzzles/desert/elevator/clear_station_1_blocks

