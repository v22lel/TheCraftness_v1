#file: ./elevator/go_to_bottom
/execute if score #running escapemap_desert_elevator matches 0 unless score #current_station escapemap_desert_elevator matches 0 run scoreboard players set #target_station escapemap_desert_elevator 0
/execute if score #running escapemap_desert_elevator matches 0 unless score #current_station escapemap_desert_elevator matches 0 run function escapemap:puzzles/desert/elevator/prepare_trip

#file: ./elevator/go_to_top
/execute if score #running escapemap_desert_elevator matches 0 unless score #current_station escapemap_desert_elevator matches 1 run scoreboard players set #target_station escapemap_desert_elevator 1
/execute if score #running escapemap_desert_elevator matches 0 unless score #current_station escapemap_desert_elevator matches 1 run function escapemap:puzzles/desert/elevator/prepare_trip

#file: ./elevator/prepare_trip
/scoreboard players set #running escapemap_desert_elevator 1
/function escapemap:puzzles/desert/elevator_listener/start
/execute if score #current_station escapemap_desert_elevator matches 0 if score #target_station escapemap_desert_elevator matches 1 run scoreboard players set #dir_sign escapemap_desert_elevator 1
/execute if score #current_station escapemap_desert_elevator matches 0 if score #target_station escapemap_desert_elevator matches 1 run scoreboard players set #max_cycles escapemap_desert_elevator 13
/execute if score #current_station escapemap_desert_elevator matches 1 if score #target_station escapemap_desert_elevator matches 0 run scoreboard players set #dir_sign escapemap_desert_elevator -1
/execute if score #current_station escapemap_desert_elevator matches 1 if score #target_station escapemap_desert_elevator matches 0 run scoreboard players set #max_cycles escapemap_desert_elevator 13
/execute if score #current_station escapemap_desert_elevator matches 0 run function escapemap:puzzles/desert/elevator/clear_station_0_blocks
/execute if score #current_station escapemap_desert_elevator matches 1 run function escapemap:puzzles/desert/elevator/clear_station_1_blocks
/execute if score #current_station escapemap_desert_elevator matches 0 run execute positioned -169 -51 -31 run function escapemap:puzzles/desert/elevator/summon_entities
/execute if score #current_station escapemap_desert_elevator matches 1 run execute positioned -169 -38 -31 run function escapemap:puzzles/desert/elevator/summon_entities
/function escapemap:puzzles/desert/elevator/calculate_distance
/execute as @a[x=-171.5,y=-53,z=-33.5,dx=6,dy=19,dz=6] at @s run tp @s ~ ~0.1 ~

