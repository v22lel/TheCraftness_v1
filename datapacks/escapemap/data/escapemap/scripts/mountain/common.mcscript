modal resetShelf(pos, face) {
    /setblock $(pos) minecraft:pale_oak_shelf[facing=$(face)]{Items:[{Slot:0b,id:"minecraft:black_concrete",count:1},{Slot:2b,id:"minecraft:black_concrete",count:1}]}
}

modal incrementShelf(pos) {
    /execute if data block $(pos) {Items:[{Slot:0b,id:"minecraft:sea_lantern"}]} run data merge block $(pos) {Items:[{Slot:0b,id:"minecraft:sea_lantern"},{Slot:2b,id:"minecraft:sea_lantern"}]}
    /execute unless data block $(pos) {Items:[{Slot:0b,id:"minecraft:sea_lantern"}]} run data merge block $(pos) {Items:[{Slot:0b,id:"minecraft:sea_lantern"},{Slot:2b,id:"minecraft:black_concrete"}]}
}

#file: ./tick
/function escapemap:mountain/sprint/tick

#file: ./reset
resetShelf('45 12 -60', 'west')
resetShelf('46 12 -59', 'south')
resetShelf('47 12 -60', 'east')
resetShelf('46 12 -61', 'north')
//sprint shelf
resetShelf('49 12 -48', 'north')

/function escapemap:mountain/sprint/reset

#file: ./laser_debug_complete
lasers_complete P += 1
/function escapemap:mountain/laser_complete

#file: ./laser_complete
if('score P lasers_complete matches 1..2') {
    //sprint shelf
    incrementShelf('49 12 -48')

    incrementShelf('45 12 -60')

    if(lasers_complete P == 2) {
        /function escapemap:mountain/sprint/unlock_collection
    }
}
if('score P lasers_complete matches 3..4') {
    incrementShelf('46 12 -59')
}
if('score P lasers_complete matches 5..6') {
    incrementShelf('47 12 -60')
}
if('score P lasers_complete matches 7..8') {
    incrementShelf('46 12 -61')
}