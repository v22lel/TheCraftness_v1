// Multi-slot item updates; filtering lives in slot_source/inventory.
#file: ./items/candle_flint_and_steel
/item modify entity @s escapemap:inventory/flint_and_steel_ground escapemap:candle_flint_and_steel

#file: ./items/multitool_neutral
/item modify entity @s escapemap:inventory/shears_multitool escapemap:multitool/neutral

#file: ./items/multitool_village_yard
/item modify entity @s escapemap:inventory/shears_multitool escapemap:multitool/village_yard

#file: ./items/multitool_spawn_tutorial
/item modify entity @s escapemap:inventory/shears_multitool escapemap:multitool/spawn_tutorial

#file: ./items/multitool_mini_cave
/item modify entity @s escapemap:inventory/shears_multitool escapemap:multitool/mini_cave

#file: ./items/village_yard_redstone_neutral
/item modify entity @s escapemap:inventory/redstone_village_yard escapemap:village_yard_redstone/neutral

#file: ./items/village_yard_redstone_active
/item modify entity @s escapemap:inventory/redstone_village_yard escapemap:village_yard_redstone/active
/item modify entity @s escapemap:inventory/redstone_ground escapemap:village_yard_redstone/active

#file: ./items/castle_stair_neutral
/item modify entity @s escapemap:inventory/oak_stairs_castle_stair escapemap:castle_stair/neutral

#file: ./items/castle_stair_active
/item modify entity @s escapemap:inventory/oak_stairs_castle_stair escapemap:castle_stair/active

#file: ./items/flashlight_neutral
/item modify entity @s escapemap:inventory/tropical_fish_flashlight escapemap:flashlight/neutral
/item modify entity @s escapemap:inventory/soul_torch_flashlight escapemap:flashlight/neutral

#file: ./items/flashlight_basement
/item modify entity @s escapemap:inventory/tropical_fish_flashlight escapemap:flashlight/basement
/item modify entity @s escapemap:inventory/soul_torch_flashlight escapemap:flashlight/basement

#file: ./items/flashlight_active
/item modify entity @s escapemap:inventory/tropical_fish_flashlight escapemap:flashlight/active
/item modify entity @s escapemap:inventory/soul_torch_flashlight escapemap:flashlight/active

#file: ./items/desert_leaves_neutral
/item modify entity @s escapemap:inventory/pale_oak_leaves_desert_leaves escapemap:desert_leaves/neutral

#file: ./items/desert_leaves_active
/item modify entity @s escapemap:inventory/pale_oak_leaves_desert_leaves escapemap:desert_leaves/active

#file: ./items/desert_wall_neutral
/item modify entity @s escapemap:inventory/sandstone_wall_desert_wall escapemap:desert_wall/neutral

#file: ./items/desert_wall_active
/item modify entity @s escapemap:inventory/sandstone_wall_desert_wall escapemap:desert_wall/active
