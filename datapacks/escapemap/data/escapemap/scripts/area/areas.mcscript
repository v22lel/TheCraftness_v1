#file: ./areas/changed
/execute if score @s area matches 0 run function escapemap:area/areas/neutral
/execute if score @s area matches 1 run function escapemap:area/areas/village_yard
/execute if score @s area matches 2 run function escapemap:area/areas/spawn_tutorial
/execute if score @s area matches 3 run function escapemap:area/areas/village_cyan
/execute if score @s area matches 4 run function escapemap:area/areas/castle
/execute if score @s area matches 5 run function escapemap:area/areas/basement
/execute if score @s area matches 6 run function escapemap:area/areas/mini_cave
/execute if score @s area matches 7 run function escapemap:area/areas/desert

// Pickup locks are maintained every tick by drop/pickup_rules, not only on area changes.

#file: ./freeze_items
/execute as @e[type=item] if items entity @s contents *[minecraft:custom_data~{puzzle:{id:"ground"}}] unless data entity @s {PickupDelay:32767s} run data modify entity @s PickupDelay set value 32767s

#file: ./unfreeze_items
/execute as @e[type=item] if items entity @s contents *[minecraft:custom_data~{puzzle:{id:"ground"}}] if data entity @s {PickupDelay:32767s} run data modify entity @s PickupDelay set value 0s

#file: ./areas/neutral
/function escapemap:area/items/multitool_neutral
/function escapemap:area/items/village_yard_redstone_neutral
/function escapemap:area/items/castle_stair_neutral
/function escapemap:area/items/flashlight_active
/function escapemap:area/items/desert_leaves_neutral
/function escapemap:area/items/desert_wall_neutral

#file: ./areas/village_yard
/function escapemap:area/items/multitool_village_yard
/function escapemap:area/items/village_yard_redstone_active

#file: ./areas/spawn_tutorial
/function escapemap:area/items/multitool_spawn_tutorial

#file: ./areas/village_cyan
/function escapemap:area/items/village_yard_redstone_active

#file: ./areas/castle
/function escapemap:area/items/castle_stair_active

#file: ./areas/basement
/function escapemap:area/items/flashlight_basement

#file: ./areas/mini_cave
/function escapemap:area/items/multitool_mini_cave

#file: ./areas/desert
/function escapemap:area/items/desert_leaves_active
/function escapemap:area/items/desert_wall_active
/function escapemap:area/items/multitool_spawn_tutorial

#file: ./areas/inventory_changed
/function escapemap:area/areas/changed
/function escapemap:area/items/candle_flint_and_steel
/advancement revoke @s only escapemap:inventory_changed