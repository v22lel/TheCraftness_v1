for(0,18,i){
    #file: ./nutrient/anim/$(i)
    /playsound minecraft:entity.small_sulfur_cube.eat block @a $(path_positions).$(i) 5 0.8
    /setblock $(path_positions).$(i) slime_block
}

#file: ./nutrient/lamp
/setblock -19 -41 21 waxed_oxidized_copper_bulb[lit=true]
/function escapemap:puzzles/complete

#file: ./nutrient/sound
/playsound minecraft:entity.small_sulfur_cube.eat block @a -18 -40 12 5 0.8

#file: ./nutrient/complete
/function escapemap:puzzles/radiation/lab/pipe2_off

#file: ./nutrient/start
for(0,18,i){
    /schedule function escapemap:puzzles/radiation/nutrient/anim/$(i) $(path_delays).$(i) replace
}
/schedule function escapemap:puzzles/radiation/nutrient/lamp 15t replace

/schedule function escapemap:puzzles/radiation/nutrient/sound 42t append
/schedule function escapemap:puzzles/radiation/nutrient/sound 45t append
/schedule function escapemap:puzzles/radiation/nutrient/sound 48t append
/schedule function escapemap:puzzles/radiation/nutrient/sound 51t append
/schedule function escapemap:puzzles/radiation/nutrient/sound 54t append
/schedule function escapemap:puzzles/radiation/nutrient/sound 57t append

/schedule function escapemap:puzzles/radiation/nutrient/complete 81t replace

#file: ./nutrient/reset
/function escapemap:puzzles/radiation/lab/pipe2_on

/setblock -19 -45 21 chiseled_resin_bricks
