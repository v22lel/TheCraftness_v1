#file: ./load

var radiation
var rad_tier
var rad_div
var rad_timer timer = 0
var rad_roll

#file: ./tick
/function escapemap:puzzles/radiation/bacteria/tick

as (@a) {
    if (area @s == 8 && radiation @s < 2000) {
        radiation @s += 1
        if (radiation @s == 100) {
            /execute as @s run function escapemap:puzzles/radiation/apply_effects
        }
        if (radiation @s == 400) {
            rad_tier @s = 1
            /execute as @s run function escapemap:puzzles/radiation/apply_effects
        }
        if (radiation @s == 800) {
            rad_tier @s = 2
            /execute as @s run function escapemap:puzzles/radiation/apply_effects
        }
        if (radiation @s == 1600) {
            rad_tier @s = 3
            /execute as @s run function escapemap:puzzles/radiation/apply_effects
        }
        if (radiation @s >= 1999) {
            rad_tier @s = 4
            /execute as @s run function escapemap:puzzles/radiation/apply_effects
        }
    }
    unless (area @s == 8) {
        if (radiation @s > 3) {
            radiation @s -= 8
            if ('score @s radiation matches 90..99') {
                /execute as @s run function escapemap:puzzles/radiation/apply_effects
            }
            if ('score @s radiation matches 390..399') {
                rad_tier @s = 0
                /execute as @s run function escapemap:puzzles/radiation/apply_effects
            }
            if ('score @s radiation matches 790..799') {
                rad_tier @s = 1
                /execute as @s run function escapemap:puzzles/radiation/apply_effects
            }
            if ('score @s radiation matches 1590..1599') {
                rad_tier @s = 2
                /execute as @s run function escapemap:puzzles/radiation/apply_effects
            }
            if ('score @s radiation matches 1990..2000') {
                rad_tier @s = 3
                /execute as @s run function escapemap:puzzles/radiation/apply_effects
            }
        }
        if ('score @s radiation matches 1..9') {
            /execute as @s run function escapemap:puzzles/radiation/apply_effects
            radiation @s = 0
        }
    }
    /scoreboard players operation @s rad_div = @s radiation
    /scoreboard players operation @s rad_div /= 20 numbers
}

rad_timer timer += 1
if (rad_timer timer == 100) {
    /execute as @a run attribute @s minecraft:movement_speed modifier remove radiation
    as (@a[scores={rad_tier=1..}]) {
        /function escapemap:puzzles/radiation/radiation_tick
    }
    rad_timer timer = 0
}

#file: ./apply_effects
/attribute @s minecraft:block_interaction_range modifier remove radiation
/posteffect clear @s

if (rad_tier @s == 0) {
    if (radiation @s == 100) {
        /posteffect add @s escapemap:radiation0
        /posteffect add @s minecraft:blur
    }
    if ('score @s radiation matches 390..399') {
        /posteffect add @s escapemap:radiation0
        /posteffect add @s minecraft:blur
    }
}

if (rad_tier @s == 1) {
    /attribute @s minecraft:block_interaction_range modifier add radiation -1.5 add_value
    /posteffect add @s escapemap:radiation1
}

if (rad_tier @s == 2) {
    /attribute @s minecraft:block_interaction_range modifier add radiation -3.0 add_value
    /posteffect add @s escapemap:radiation2
}

if (rad_tier @s == 3) {
    /attribute @s minecraft:block_interaction_range modifier add radiation -4.5 add_value
    /posteffect add @s escapemap:radiation3
}

if (rad_tier @s == 4) {
    /attribute @s minecraft:block_interaction_range modifier add radiation -4.5 add_value
    /posteffect add @s escapemap:radiation4
}

unless (rad_tier @s == 0) {
    /posteffect add @s minecraft:blur
}

#file: ./radiation_tick
/execute store result score @s rad_roll run function escapemap:explicit_randomness/roll {range:'1..6'}

if (rad_tier @s >= 1) {
    if (rad_roll @s == 1) {
        /attribute @s minecraft:movement_speed modifier add radiation -0.01 add_value
    }
    if (rad_roll @s == 2) {
        /attribute @s minecraft:movement_speed modifier add radiation -0.02 add_value
    }
}

if (rad_tier @s >= 2) {
    if (rad_roll @s == 2) {
        /attribute @s minecraft:movement_speed modifier add radiation -0.03 add_value
    }
    if (rad_roll @s == 4) {
        /attribute @s minecraft:movement_speed modifier add radiation -0.04 add_value
    }
}

if (rad_tier @s >= 3) {
    if (rad_roll @s == 5) {
        /attribute @s minecraft:movement_speed modifier add radiation -0.05 add_value
    }
    if (rad_roll @s == 6) {
        /attribute @s minecraft:movement_speed modifier add radiation -0.06 add_value
    }
}

#file: ./reset
radiation @a = 0
rad_tier @a = 0
rad_div @a = 0
as (@a) {
    /attribute @s minecraft:block_interaction_range modifier remove radiation
    /attribute @s minecraft:movement_speed modifier remove radiation
}

/function escapemap:puzzles/radiation/bacteria/reset
/function escapemap:puzzles/radiation/valve/reset
/function escapemap:puzzles/radiation/lab/reset

/setblock -9 -37 2 minecraft:lever[facing=east,powered=false,face=floor]
/setblock -8 -39 2 air destroy

/setblock -5 -36 11 lever[facing=west,powered=false,face=floor]
/setblock -4 -38 11 air destroy

/setblock -5 -36 11 lever[facing=west,face=floor,powered=false]
/setblock -4 -38 11 air destroy

#file: ./onitemframe
/function escapemap:puzzles/radiation/valve/onitemframe