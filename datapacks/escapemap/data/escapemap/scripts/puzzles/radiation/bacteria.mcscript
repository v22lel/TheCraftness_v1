#file: ./bacteria/tick
if ('data entity @e[tag=lab_bacteria,limit=1] attack') {
    /execute positioned as @e[tag=lab_bacteria,limit=1] run function escapemap:puzzles/radiation/bacteria/pickup
}

if ('data entity @e[tag=lab_bacteria,limit=1] interaction') {
    /execute positioned as @e[tag=lab_bacteria,limit=1] run function escapemap:puzzles/radiation/bacteria/pickup
}

if ('data entity @e[tag=lab_petri,limit=1] attack') {
    /execute positioned as @e[tag=lab_petri,limit=1] run function escapemap:puzzles/radiation/bacteria/cultivate
}

if ('data entity @e[tag=lab_petri,limit=1] interaction') {
    /execute positioned as @e[tag=lab_petri,limit=1] run function escapemap:puzzles/radiation/bacteria/cultivate
}

if ('data entity @e[tag=lab_growth1,limit=1] attack') {
    /execute positioned as @e[tag=lab_growth1,limit=1] run function escapemap:puzzles/radiation/bacteria/grow1
}

if ('data entity @e[tag=lab_growth1,limit=1] interaction') {
    /execute positioned as @e[tag=lab_growth1,limit=1] run function escapemap:puzzles/radiation/bacteria/grow1
}

if ('data entity @e[tag=lab_growth2,limit=1] attack') {
    /execute positioned as @e[tag=lab_growth2,limit=1] run function escapemap:puzzles/radiation/bacteria/grow2
}

if ('data entity @e[tag=lab_growth2,limit=1] interaction') {
    /execute positioned as @e[tag=lab_growth2,limit=1] run function escapemap:puzzles/radiation/bacteria/grow2
}

if ('data entity @e[tag=lab_door,limit=1] attack') {
    /execute positioned as @e[tag=lab_door,limit=1] run function escapemap:puzzles/radiation/bacteria/door
}

if ('data entity @e[tag=lab_door,limit=1] interaction') {
    /execute positioned as @e[tag=lab_door,limit=1] run function escapemap:puzzles/radiation/bacteria/door
}

if ('data entity @e[tag=lab_merge,limit=1] attack') {
    /execute positioned as @e[tag=lab_merge,limit=1] run function escapemap:puzzles/radiation/bacteria/enhance
}

if ('data entity @e[tag=lab_merge,limit=1] interaction') {
    /execute positioned as @e[tag=lab_merge,limit=1] run function escapemap:puzzles/radiation/bacteria/enhance
}

as (@e[type=item]) {
    if ('data entity @s {Item:{components:{"minecraft:custom_data":{"puzzle":{"id":"bacteria_alive"}}}}}') {
        /item modify entity @s contents escapemap:bacteria/dead
    }
    if ('data entity @s {Item:{components:{"minecraft:custom_data":{"puzzle":{"id":"bacteria_cultivated"}}}}}') {
       /item modify entity @s contents escapemap:bacteria/dead
    }
}

#file: ./bacteria/pickup
/data remove entity @e[tag=lab_bacteria,limit=1] attack
/data remove entity @e[tag=lab_bacteria,limit=1] interaction

unless ('items entity @p escapemap:inventory/alive_bacteria *') {
    as(@p) {
        /function escapemap:items/alive_bacteria
    }
}

#file: ./bacteria/cultivate
/data remove entity @e[tag=lab_petri,limit=1] attack
/data remove entity @e[tag=lab_petri,limit=1] interaction

/item modify entity @p escapemap:inventory/alive_bacteria escapemap:bacteria/cultivated

#file: ./bacteria/grow1
/data remove entity @e[tag=lab_growth1,limit=1] attack
/data remove entity @e[tag=lab_growth1,limit=1] interaction
if ('items entity @p escapemap:inventory/cultivated_bacteria *') {
    /setblock -12 -45 18 slime_block
    /setblock -12 -43 18 air
    /item modify entity @p escapemap:inventory/cultivated_bacteria escapemap:consume
}

#file: ./bacteria/grow2
/data remove entity @e[tag=lab_growth2,limit=1] attack
/data remove entity @e[tag=lab_growth2,limit=1] interaction
if ('items entity @p escapemap:inventory/cultivated_bacteria *') {
    /setblock -19 -45 20 slime_block
    /function escapemap:puzzles/radiation/nutrient/start
    /item modify entity @p escapemap:inventory/cultivated_bacteria escapemap:consume
}

#file: ./bacteria/door
/data remove entity @e[tag=lab_door,limit=1] attack
/data remove entity @e[tag=lab_door,limit=1] interaction
if ('block -35 -44 12 waxed_copper_door') {
    if ('items entity @p escapemap:inventory/strong_bacteria *') {
        /function escapemap:puzzles/radiation/bacteria/eat_door
        /item modify entity @p escapemap:inventory/strong_bacteria escapemap:consume
    }
}

#file: ./bacteria/enhance
/data remove entity @e[tag=lab_merge,limit=1] attack
/data remove entity @e[tag=lab_merge,limit=1] interaction
if ('block -24 -44 0 lava' && 'block -33 -44 7 lava' && 'block -34 -44 16 lava') {
    if ('items entity @p escapemap:inventory/cultivated_bacteria *') {
        /item modify entity @p escapemap:inventory/cultivated_bacteria escapemap:bacteria/strengthened
    }
}

#file: ./bacteria/reset
/function escapemap:puzzles/radiation/nutrient/reset
/kill @e[tag=lab_interaction]
/summon interaction -14.50 -43.00 1.50 {width:1f,height:0.3f,Tags:["lab_bacteria","lab_interaction"]}
/summon interaction -7.5 -43.00 -0.5 {width:1f,height:0.3f,Tags:["lab_petri","lab_interaction"]}
/summon interaction -6.5 -44.00 -0.5 {width:1.01,height:1.01,Tags:["lab_guard","lab_interaction"]}
/summon interaction -11.5 -45.00 18.5 {width:1,height:0.4,Tags:["lab_growth1","lab_interaction"]}
/summon interaction -18.5 -45.00 20.5 {width:1,height:0.4,Tags:["lab_growth2","lab_interaction"]}
/summon interaction -34.5 -44.00 12.5 {width:1.01,height:2.0,Tags:["lab_door","lab_interaction"]}
/summon interaction -5.75 -43.00 6.5 {width:1.0,height:1.0,Tags:["lab_merge","lab_interaction"]}

//slimy door
/setblock -35 -44 13 minecraft:quartz_block
/setblock -35 -43 11 minecraft:quartz_block
/setblock -34 -45 12 minecraft:quartz_block
/setblock -35 -43 13 minecraft:quartz_block
/setblock -35 -44 11 minecraft:quartz_block
/setblock -35 -42 12 minecraft:quartz_block

/setblock -12 -45 18 water
/setblock -12 -43 18 barrier

/setblock -19 -45 20 water

/function escapemap:puzzles/radiation/bacteria/set_door/0


#file: ./bacteria/eat_door
/function escapemap:puzzles/radiation/bacteria/set_door/0
/function escapemap:puzzles/radiation/bacteria/set_door/sound

for(1,6,i){
    /schedule function escapemap:puzzles/radiation/bacteria/set_door/$(i) $(i)s replace
}
for(1,6){
    /schedule function escapemap:puzzles/radiation/bacteria/set_door/sound $(i)s append
}

/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound2 35t append
/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound2 40t append
/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound3 42t append
/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound2 43t append
/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound3 46t append
/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound3 49t append
/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound2 65t append
/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound3 67t append
/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound2 69t append
/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound3 83t append
/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound3 85t append
/schedule function escapemap:puzzles/radiation/bacteria/set_door/sound2 95t append

#file: ./bacteria/set_door/0
/setblock -35 -44 12 waxed_copper_door[facing=west,half=lower] strict
/setblock -35 -43 12 waxed_copper_door[facing=west,half=upper] strict

#file: ./bacteria/set_door/1
/setblock -35 -44 12 waxed_exposed_copper_door[facing=west,half=lower] strict
/setblock -35 -43 12 waxed_exposed_copper_door[facing=west,half=upper] strict
/setblock -35 -44 13 minecraft:potent_sulfur

#file: ./bacteria/set_door/2
/setblock -35 -44 12 waxed_weathered_copper_door[facing=west,half=lower] strict
/setblock -35 -43 12 waxed_weathered_copper_door[facing=west,half=upper] strict
/setblock -35 -43 11 minecraft:potent_sulfur
/setblock -34 -45 12 minecraft:slime_block

#file: ./bacteria/set_door/3
/setblock -35 -44 12 waxed_oxidized_copper_door[facing=west,half=lower] strict
/setblock -35 -43 12 waxed_oxidized_copper_door[facing=west,half=upper] strict
/setblock -35 -43 13 minecraft:slime_block

#file: ./bacteria/set_door/4
/setblock -35 -44 12 waxed_oxidized_copper_bars[south=true,north=true] strict
/setblock -35 -43 12 waxed_oxidized_copper_bars[south=true,north=true] strict
/setblock -35 -44 11 minecraft:slime_block

#file: ./bacteria/set_door/5
/setblock -35 -44 12 air
/setblock -35 -42 12 minecraft:slime_block

#file: ./bacteria/set_door/6
/setblock -35 -43 12 air

#file: ./bacteria/set_door/sound
/playsound minecraft:entity.small_sulfur_cube.eat block @a -35 -43 12 5 0.8

#file: ./bacteria/set_door/sound2
/playsound minecraft:block.slime_block.hit master @a -35 -43 12 1 1

#file: ./bacteria/set_door/sound3
/playsound minecraft:block.slime_block.place master @a -35 -43 12 1 1