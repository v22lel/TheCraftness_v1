#file: ./lab/pipe1_on
/setblock -7 -39 11 water
/setblock -7 -43 11 barrier[waterlogged=true]
/setblock -7 -44 11 water

#file: ./lab/pipe1_off
/setblock -7 -39 11 air
/setblock -7 -43 11 air
/setblock -7 -44 11 air
/fill -7 -42 11 -7 -39 11 air

#file: ./lab/pipe2_on
/setblock -20 -39 3 air
/setblock -20 -38 3 water
/setblock -20 -43 3 barrier[waterlogged=true]
/setblock -20 -44 3 water

#file: ./lab/pipe2_off
/setblock -20 -43 3 air
/setblock -20 -44 3 air
/fill -20 -42 3 -20 -39 3 air
/setblock -20 -39 3 slime_block

#file: ./lab/branch_left
/setblock -10 -38 1 air
/setblock -8 -38 1 minecraft:mossy_stone_brick_slab[type=bottom]

/setblock -6 -43 2 air
/setblock -6 -44 2 air

/setblock -12 -43 5 minecraft:barrier[waterlogged=true]
/setblock -12 -44 5 water


#file: ./lab/branch_right
/setblock -10 -38 1 minecraft:mossy_stone_brick_slab[type=bottom]
/setblock -8 -38 1 air

/setblock -6 -43 2 minecraft:barrier[waterlogged=true]
/setblock -6 -44 2 water

/setblock -12 -43 5 air
/setblock -12 -44 5 air

#file: ./lab/pipe3_on
/setblock -29 -38 12 water
/schedule function escapemap:puzzles/radiation/lab/pipe3_on_delay 32t replace
/schedule clear escapemap:puzzles/radiation/lab/pipe3_off_delay1
/schedule clear escapemap:puzzles/radiation/lab/pipe3_off_delay2

#file: ./lab/pipe3_on_delay
/setblock -29 -43 12 minecraft:barrier[waterlogged=true]
/setblock -29 -44 12 water

#file: ./lab/pipe3_off
/setblock -29 -38 12 air
/schedule function escapemap:puzzles/radiation/lab/pipe3_off_delay1 26t replace
/schedule function escapemap:puzzles/radiation/lab/pipe3_off_delay2 32t replace
/schedule clear escapemap:puzzles/radiation/lab/pipe3_on_delay

#file: ./lab/pipe3_off_delay1
/setblock -29 -43 12 air
/setblock -29 -44 12 barrier[waterlogged=true]

#file: ./lab/pipe3_off_delay2
/setblock -29 -44 12 air

#file: ./lab/pipe3_toggle
/execute store success storage escapemap:tmp pipeOn byte 1 if block -29 -38 12 water
/execute if data storage escapemap:tmp {pipeOn:1b} run function escapemap:puzzles/radiation/lab/pipe3_off
/execute if data storage escapemap:tmp {pipeOn:0b} run function escapemap:puzzles/radiation/lab/pipe3_on