#file: ./lab/pipe1_on
/setblock -7 -39 11 water
/setblock -7 -43 11 barrier[waterlogged=true]
/setblock -7 -44 11 water

#file: ./lab/pipe1_off
/setblock -7 -39 11 air
/setblock -7 -43 11 air
/setblock -7 -44 11 air
/fill -7 -42 11 -7 -39 11 air

#file: ./lab/pipe2_on
