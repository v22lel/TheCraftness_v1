var desert_corridor

modal toggleLamp(pos) {
    /data modify storage escapemap:tmp isRedstone set value 0b
    /execute if block $(pos) redstone_block run data modify storage escapemap:tmp isRedstone set value 1b

    /execute if data storage escapemap:tmp {isRedstone:1b} run setblock $(pos) air
    /execute if data storage escapemap:tmp {isRedstone:0b} run setblock $(pos) redstone_block
}

modal rsCheck(pos) {
    if ('block $(pos) redstone_block') {
        desert_corridor C += 1
    }
}

#file: ./corridor/reset
desert_corridor C = 0
desert_corridor P = 0
/setblock -190 -49 48 air
/setblock -184 -49 46 air
/setblock -190 -49 44 air
/setblock -184 -49 48 air
/setblock -190 -49 46 air
