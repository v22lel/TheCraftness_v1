rsCheck('-184 -49 38')
rsCheck('-190 -49 36')
rsCheck('-184 -49 40')
rsCheck('-190 -49 38')
rsCheck('-184 -49 36')
rsCheck('-190 -49 34')
rsCheck('-184 -49 34')
/execute if score C desert_corridor matches 16.. run function escapemap:puzzles/desert/corridor/complete

#file: ./corridor/complete
if (desert_corridor P == 0) {
    /function escapemap:puzzles/complete
    /setblock -172 -51 31 waxed_oxidized_copper_bulb[lit=true]
}
desert_corridor P = 1
/function escapemap:puzzles/desert/ocd/check

