/setblock -190 -49 36 air
/setblock -184 -49 40 air
/setblock -190 -49 38 air
/setblock -184 -49 36 air
/setblock -190 -49 34 air
/setblock -184 -49 34 air
/setblock -172 -51 31 waxed_oxidized_copper_bulb[lit=false,powered=false]

#file: ./corridor/check
desert_corridor C = 0
rsCheck('-190 -49 48')
rsCheck('-184 -49 46')
rsCheck('-190 -49 44')
rsCheck('-184 -49 48')
rsCheck('-190 -49 46')
rsCheck('-190 -49 42')
