#file: ./cave/check
desert_cave C = 0
/execute as @e[tag=pp_cave_fake] run scoreboard players add C desert_cave 1
if(desert_cave C == 8){
    /function escapemap:puzzles/desert/cave/complete
}

#file: ./cave/complete
if(desert_cave P == 0) {
    /function escapemap:puzzles/secret_complete {p:"-184 -36 71"}
    /setblock -170 -41 71 minecraft:waxed_copper_bulb[lit=true]
}
desert_cave P = 1
