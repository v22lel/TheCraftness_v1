// secret with the wood door from the big room, 3x5 lights out, opens attic in lonely house
var desert_pp6

modal togglePressurePlate6(sspos, pppos) {
    /data modify storage escapemap:tmp isStone set value 0b
    /execute unless block $(sspos) sandstone_slab positioned $(pppos) unless entity @e[tag=pp6_fake,distance=..1] run data modify storage escapemap:tmp isStone set value 1b

    /execute unless block $(sspos) sandstone_slab if block $(pppos) stone_pressure_plate if data storage escapemap:tmp {isStone:1b} positioned $(pppos) run summon minecraft:block_display ~-0.5 ~-0.5 ~-0.5 {Tags:["pp6_fake"],block_state:{id:"minecraft:light_weighted_pressure_plate"},transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.025f,0.0f,-0.025f],scale:[1.05f,1.05f,1.05f]}}
    /execute unless block $(sspos) sandstone_slab if block $(pppos) stone_pressure_plate if data storage escapemap:tmp {isStone:0b} positioned $(pppos) as @e[tag=pp6_fake,distance=..1] run kill @s
}

modal toggleSelf6(pos) {
    /data modify storage escapemap:tmp isStone set value 0b
    /execute positioned $(pos) unless entity @e[tag=pp6_fake,distance=..1] run data modify storage escapemap:tmp isStone set value 1b

    /execute if data storage escapemap:tmp {isStone:1b} positioned $(pos) run summon minecraft:block_display ~-0.5 ~-0.5 ~-0.5 {Tags:["pp6_fake"],block_state:{id:"minecraft:light_weighted_pressure_plate"},transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.025f,0.0f,-0.025f],scale:[1.05f,1.05f,1.05f]}}
    /execute if data storage escapemap:tmp {isStone:0b} positioned $(pos) as @e[tag=pp6_fake,distance=..1] run kill @s
}

#file: ./post_secret/reset
desert_pp6 C = 0
desert_pp6 P = 0
/kill @e[tag=pp6_fake]
/setblock -178 -45 62 minecraft:waxed_oxidized_copper_bulb[lit=false]
/setblock -117 -35 46 air
/setblock -117 -36 46 oak_slab[type=top]

#file: ./post_secret/toggle
togglePressurePlate6("~ ~1 ~-1", "~ ~2 ~-2")
togglePressurePlate6("~ ~1 ~1", "~ ~2 ~2")
togglePressurePlate6("~-1 ~1 ~", "~-2 ~2 ~")
togglePressurePlate6("~1 ~1 ~", "~2 ~2 ~")
toggleSelf6("~ ~2 ~")

/function escapemap:puzzles/desert/post_secret/check

// intertwined one
#file: ./post_secret/toggle_special1
toggleSelf6('-182 -49.5 64')
/function escapemap:puzzles/desert/post_secret/check

// further one
#file: ./post_secret/toggle_special2
toggleSelf6('-156 -49.5 23')
/function escapemap:puzzles/desert/post_secret/check

#file: ./post_secret/check
desert_pp6 C = 0
/execute as @e[tag=pp6_fake] run scoreboard players add C desert_pp6 1
if(desert_pp6 C == 16){
    /function escapemap:puzzles/desert/post_secret/complete
}

#file: ./post_secret/complete
if(desert_pp6 P == 0) {
    /function escapemap:puzzles/complete
    /setblock -178 -45 62 minecraft:waxed_oxidized_copper_bulb[lit=true]
    /setblock -117 -35 46 oak_slab[type=bottom]
    /setblock -117 -36 46 air
}
desert_pp6 P = 1

#file: ./post_secret/open_door
/setblock -179 -50 57 air
/setblock -179 -49 57 air

#file: ./post_secret/close_door
/setblock -179 -50 57 oak_stairs[facing=south]
/setblock -179 -49 57 sandstone_stairs[facing=south,half=top]