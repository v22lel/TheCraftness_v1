#file: ./ls1/load

#file: ./ls1/reset
desert_ls1 C = 0
desert_ls1 P = 0
/kill @e[tag=ls1_fake]
/setblock -160 -49 30 minecraft:waxed_copper_bulb[lit=false]
/setblock -156 -51 28 soul_campfire[lit=false]

#file: ./ls1/toggle1
togglePressurePlateLS1("~ ~2 ~-2")
togglePressurePlateLS1("~ ~2 ~2")
togglePressurePlateLS1("~-2 ~2 ~")
togglePressurePlateLS1("~2 ~2 ~")
toggleSelfLS1("~ ~2 ~")
/function escapemap:puzzles/desert/ls1/check

#file: ./ls1/toggle2
togglePressurePlateLS2("~ ~2 ~-2")
togglePressurePlateLS2("~ ~2 ~2")
togglePressurePlateLS2("~-2 ~2 ~")
togglePressurePlateLS2("~2 ~2 ~")
toggleSelfLS2("~ ~2 ~")
/function escapemap:puzzles/desert/ls1/check

#file: ./ls1/toggle3
togglePressurePlateLS3("~ ~2 ~-2")
togglePressurePlateLS3("~ ~2 ~2")
togglePressurePlateLS3("~-2 ~2 ~")
togglePressurePlateLS3("~2 ~2 ~")
toggleSelfLS3("~ ~2 ~")
/function escapemap:puzzles/desert/ls1/check

#file: ./ls1/toggle4
togglePressurePlateLS4("~ ~2 ~-2")
togglePressurePlateLS4("~ ~2 ~2")
togglePressurePlateLS4("~-2 ~2 ~")
togglePressurePlateLS4("~2 ~2 ~")
toggleSelfLS4("~ ~2 ~")
/function escapemap:puzzles/desert/ls1/check

#file: ./ls1/check
desert_ls1 C = 0
/execute as @e[tag=ls1_fake] run scoreboard players add C desert_ls1 1
if(desert_ls1 C == 24){
    /function escapemap:puzzles/desert/ls1/complete
}

#file: ./ls1/complete
if(desert_ls1 P == 0) {
    /function escapemap:puzzles/secret_complete {p:'-156 -51 28'}
    /setblock -160 -49 30 minecraft:waxed_copper_bulb[lit=true]
}
desert_ls1 P = 1