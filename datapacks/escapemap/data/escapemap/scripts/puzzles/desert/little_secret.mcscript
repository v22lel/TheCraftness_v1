var desert_ls1

modal togglePressurePlateLS1(pppos) {
    /data modify storage escapemap:tmp isStone1 set value 0b
    /execute if block $(pppos) stone_pressure_plate positioned $(pppos) unless entity @e[tag=ls1_fake1,distance=..1] run data modify storage escapemap:tmp isStone1 set value 1b

    /execute if block $(pppos) stone_pressure_plate if data storage escapemap:tmp {isStone1:1b} positioned $(pppos) run summon minecraft:block_display ~-0.5 ~-0.5 ~-0.5 {Tags:["ls1_fake1", "ls1_fake"],block_state:{Name:"minecraft:light_weighted_pressure_plate"},transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.025f,0.0f,-0.025f],scale:[1.05f,1.05f,1.05f]}}
    /execute if block $(pppos) stone_pressure_plate if data storage escapemap:tmp {isStone1:0b} positioned $(pppos) as @e[tag=ls1_fake1,distance=..1] run kill @s
}

modal toggleSelfLS1(pos) {
    /data modify storage escapemap:tmp isStone1 set value 0b
    /execute positioned $(pos) unless entity @e[tag=ls1_fake1,distance=..1] run data modify storage escapemap:tmp isStone1 set value 1b

    /execute if data storage escapemap:tmp {isStone1:1b} positioned $(pos) run summon minecraft:block_display ~-0.5 ~-0.5 ~-0.5 {Tags:["ls1_fake1", "ls1_fake"],block_state:{Name:"minecraft:light_weighted_pressure_plate"},transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.025f,0.0f,-0.025f],scale:[1.05f,1.05f,1.05f]}}
    /execute if data storage escapemap:tmp {isStone1:0b} positioned $(pos) as @e[tag=ls1_fake1,distance=..1] run kill @s
}

