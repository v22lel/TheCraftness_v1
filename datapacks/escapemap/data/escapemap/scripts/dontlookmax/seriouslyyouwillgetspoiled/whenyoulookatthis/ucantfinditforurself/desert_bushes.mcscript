var zzz_desert_bushes_progress

#file: ./../../../../zzz/desert_bushes/reset
/function escapemap:zzz/desert_bushes/kill
/function escapemap:zzz/desert_bushes/summon0
zzz_desert_bushes_progress P = 0

#file: ./../../../../zzz/desert_bushes/kill
/kill @e[tag=zzz_ia_desert_bushes]

#file: ./../../../../zzz/desert_bushes/summon0
/summon interaction -175 -37 5 {Tags:["zzz_ia_desert_bushes", "0"],height:1.1f,width:1.1f}

#file: ./../../../../zzz/desert_bushes/tick
/execute as @e[tag=zzz_ia_desert_bushes,tag=0] if data entity @s {interaction:{}} run function escapemap:zzz/desert_bushes/click_0
/execute as @e[tag=zzz_ia_desert_bushes,tag=1] if data entity @s {interaction:{}} run function escapemap:zzz/desert_bushes/click_1
/execute as @e[tag=zzz_ia_desert_bushes,tag=2] if data entity @s {interaction:{}} run function escapemap:zzz/desert_bushes/click_2
/execute as @e[tag=zzz_ia_desert_bushes,tag=3] if data entity @s {interaction:{}} run function escapemap:zzz/desert_bushes/click_3
/execute as @e[tag=zzz_ia_desert_bushes,tag=4] if data entity @s {interaction:{}} run function escapemap:zzz/desert_bushes/click_4
/execute as @e[tag=zzz_ia_desert_bushes,tag=5] if data entity @s {interaction:{}} run function escapemap:zzz/desert_bushes/click_5
/execute if score P zzz_desert_bushes_progress matches 0..5 run function escapemap:zzz/desert_bushes/particle_0
/execute if score P zzz_desert_bushes_progress matches 1..5 run function escapemap:zzz/desert_bushes/particle_1
/execute if score P zzz_desert_bushes_progress matches 2..5 run function escapemap:zzz/desert_bushes/particle_2
/execute if score P zzz_desert_bushes_progress matches 3..5 run function escapemap:zzz/desert_bushes/particle_3
/execute if score P zzz_desert_bushes_progress matches 4..5 run function escapemap:zzz/desert_bushes/particle_4
/execute if score P zzz_desert_bushes_progress matches 5..5 run function escapemap:zzz/desert_bushes/particle_5

#file: ./../../../../zzz/desert_bushes/complete
/say complete
/function escapemap:zzz/desert_bushes/kill

#file: ./../../../../zzz/desert_bushes/click_0
/execute as @e[tag=zzz_ia_desert_bushes,tag=0] run data remove entity @s interaction
/kill @e[tag=zzz_ia_desert_bushes,tag=1]
/kill @e[tag=zzz_ia_desert_bushes,tag=2]
/kill @e[tag=zzz_ia_desert_bushes,tag=3]
/kill @e[tag=zzz_ia_desert_bushes,tag=4]
/kill @e[tag=zzz_ia_desert_bushes,tag=5]
/summon interaction -185 -37 5 {Tags:["zzz_ia_desert_bushes", "1"],height:1.1f,width:1.1f}
/scoreboard players set P zzz_desert_bushes_progress 1
/execute if score P zzz_desert_bushes_progress matches 6 run function escapemap:zzz/desert_bushes/complete

