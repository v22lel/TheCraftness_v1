var zzz_test_progress

#file: ./../../../../zzz/test/reset
/function escapemap:zzz/test/kill
/function escapemap:zzz/test/summon0
zzz_test_progress P = 0

#file: ./../../../../zzz/test/kill
/kill @e[tag=zzz_ia_test]

#file: ./../../../../zzz/test/summon0
/summon interaction -165 -6 272 {Tags:["zzz_ia_test", "0"],height:1.1f,width:1.1f}

#file: ./../../../../zzz/test/tick
/execute as @e[tag=zzz_ia_test,tag=0] if data entity @s {interaction:{}} run function escapemap:zzz/test/click_0
/execute as @e[tag=zzz_ia_test,tag=1] if data entity @s {interaction:{}} run function escapemap:zzz/test/click_1
/execute as @e[tag=zzz_ia_test,tag=2] if data entity @s {interaction:{}} run function escapemap:zzz/test/click_2
/execute as @e[tag=zzz_ia_test,tag=3] if data entity @s {interaction:{}} run function escapemap:zzz/test/click_3
/execute as @e[tag=zzz_ia_test,tag=4] if data entity @s {interaction:{}} run function escapemap:zzz/test/click_4
/execute as @e[tag=zzz_ia_test,tag=5] if data entity @s {interaction:{}} run function escapemap:zzz/test/click_5
/execute if score P zzz_test_progress matches 0..5 run function escapemap:zzz/test/particle_0
/execute if score P zzz_test_progress matches 1..5 run function escapemap:zzz/test/particle_1
/execute if score P zzz_test_progress matches 2..5 run function escapemap:zzz/test/particle_2
/execute if score P zzz_test_progress matches 3..5 run function escapemap:zzz/test/particle_3
/execute if score P zzz_test_progress matches 4..5 run function escapemap:zzz/test/particle_4
/execute if score P zzz_test_progress matches 5..5 run function escapemap:zzz/test/particle_5

#file: ./../../../../zzz/test/complete
/say complete
/function escapemap:zzz/test/kill

#file: ./../../../../zzz/test/click_0
/execute as @e[tag=zzz_ia_test,tag=0] run data remove entity @s interaction
/kill @e[tag=zzz_ia_test,tag=1]
/kill @e[tag=zzz_ia_test,tag=2]
/kill @e[tag=zzz_ia_test,tag=3]
/kill @e[tag=zzz_ia_test,tag=4]
/kill @e[tag=zzz_ia_test,tag=5]
/summon interaction -165 -6 276 {Tags:["zzz_ia_test", "1"],height:1.1f,width:1.1f}
/scoreboard players set P zzz_test_progress 1
/execute if score P zzz_test_progress matches 6 run function escapemap:zzz/test/complete

#file: ./../../../../zzz/test/click_1
/execute as @e[tag=zzz_ia_test,tag=1] run data remove entity @s interaction
/kill @e[tag=zzz_ia_test,tag=2]
/kill @e[tag=zzz_ia_test,tag=3]
/kill @e[tag=zzz_ia_test,tag=4]
/kill @e[tag=zzz_ia_test,tag=5]
/summon interaction -161 -6 276 {Tags:["zzz_ia_test", "2"],height:1.1f,width:1.1f}
/scoreboard players set P zzz_test_progress 2
/execute if score P zzz_test_progress matches 6 run function escapemap:zzz/test/complete

#file: ./../../../../zzz/test/click_2
/execute as @e[tag=zzz_ia_test,tag=2] run data remove entity @s interaction
/kill @e[tag=zzz_ia_test,tag=3]
