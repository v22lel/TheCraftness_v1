/scoreboard players set P zzz_test_progress 3
/execute if score P zzz_test_progress matches 6 run function escapemap:zzz/test/complete

#file: ./../../../../zzz/test/click_3
/execute as @e[tag=zzz_ia_test,tag=3] run data remove entity @s interaction
/kill @e[tag=zzz_ia_test,tag=4]
/kill @e[tag=zzz_ia_test,tag=5]
