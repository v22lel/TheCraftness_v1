#file: ./docks/tick
//boat listener for spawn_dock
if(dock_state spawn_dock == 0) {
at(@a[gamemode=adventure,nbt={RootVehicle:{Entity:{id:"minecraft:spruce_boat"}}}]) {
if('entity @e[tag=boat_marker,tag=spawn_dock,limit=1,distance=..12]') {
/setblock -154 -43 124 air
/setblock -154 -41 124 air
/setblock -153 -43 123 air
/setblock -153 -41 123 air
/setblock -154 -43 125 air
/setblock -154 -41 125 air
/setblock -154 -42 125 air
/setblock -154 -42 124 air
/setblock -153 -42 123 air
dock_state spawn_dock = 2
}}}
if(dock_state spawn_dock == 2) {
at(@a[gamemode=adventure,nbt={RootVehicle:{Entity:{id:"minecraft:spruce_boat"}}}]) {
if('entity @e[tag=boat_marker,tag=spawn_dock,limit=1,distance=12..]') {
/setblock -154 -43 124 barrier
/setblock -154 -41 124 barrier
/setblock -153 -43 123 barrier
/setblock -153 -41 123 barrier
/setblock -154 -43 125 barrier
/setblock -154 -41 125 barrier
/setblock -154 -42 125 barrier
/setblock -154 -42 124 barrier
/setblock -153 -42 123 barrier
dock_state spawn_dock = 0
}}}
//boat listener for lighthouse_dock
if(dock_state lighthouse_dock == 0) {
at(@a[gamemode=adventure,nbt={RootVehicle:{Entity:{id:"minecraft:spruce_boat"}}}]) {
if('entity @e[tag=boat_marker,tag=lighthouse_dock,limit=1,distance=..13]') {
/setblock -116 -42 -40 air
/setblock -117 -42 -39 air
/setblock -116 -42 -38 air
dock_state lighthouse_dock = 2
}}}
if(dock_state lighthouse_dock == 2) {
at(@a[gamemode=adventure,nbt={RootVehicle:{Entity:{id:"minecraft:spruce_boat"}}}]) {
if('entity @e[tag=boat_marker,tag=lighthouse_dock,limit=1,distance=13..]') {
/setblock -116 -42 -40 barrier
/setblock -117 -42 -39 barrier
/setblock -116 -42 -38 barrier
dock_state lighthouse_dock = 0
}}}
//boat listener for jungle_dock
if(dock_state jungle_dock == 0) {
at(@a[gamemode=adventure,nbt={RootVehicle:{Entity:{id:"minecraft:spruce_boat"}}}]) {
if('entity @e[tag=boat_marker,tag=jungle_dock,limit=1,distance=..12]') {
/setblock 12 -42 135 air
/setblock 12 -41 135 air
/setblock 11 -42 134 air
/setblock 11 -41 134 air
dock_state jungle_dock = 2
}}}
if(dock_state jungle_dock == 2) {
at(@a[gamemode=adventure,nbt={RootVehicle:{Entity:{id:"minecraft:spruce_boat"}}}]) {
if('entity @e[tag=boat_marker,tag=jungle_dock,limit=1,distance=12..]') {
/setblock 12 -42 135 barrier
/setblock 12 -41 135 barrier
/setblock 11 -42 134 barrier
/setblock 11 -41 134 barrier
dock_state jungle_dock = 0
}}}


