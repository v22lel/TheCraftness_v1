var dock_state
#file: ./docks/call_boat/spawn_dock
/kill @e[tag=calledBoat]
/function escapemap:boat/docks/close_all

/schedule clear escapemap:boat/docks/summon/spawn_dock
/schedule clear escapemap:boat/docks/particle/spawn_dock
/schedule clear escapemap:boat/docks/particle_post/spawn_dock
/schedule function escapemap:boat/docks/particle/spawn_dock 42t append
/schedule function escapemap:boat/docks/particle/spawn_dock 60t append
/schedule function escapemap:boat/docks/particle/spawn_dock 70t append
/schedule function escapemap:boat/docks/particle/spawn_dock 80t append
/schedule function escapemap:boat/docks/particle/spawn_dock 90t append
/schedule function escapemap:boat/docks/particle/spawn_dock 95t append
/schedule function escapemap:boat/docks/particle/spawn_dock 100t append
/schedule function escapemap:boat/docks/particle/spawn_dock 105t append
/schedule function escapemap:boat/docks/particle/spawn_dock 110t append
/schedule function escapemap:boat/docks/particle/spawn_dock 115t append
/schedule function escapemap:boat/docks/summon/spawn_dock 120t replace
/schedule function escapemap:boat/docks/particle_post/spawn_dock 125t append
/schedule function escapemap:boat/docks/particle_post/spawn_dock 130t append
/schedule function escapemap:boat/docks/complete/spawn_dock 135t append
dock_state spawn_dock = 1


#file: ./docks/particle/spawn_dock
/particle minecraft:bubble -155 -43.25 122 0.7 0 0.7 0.3 75 normal
/particle minecraft:snowflake -155 -44.5 122 0.7 0 0.7 0.1 75 normal


#file: ./docks/post_particle/spawn_dock
/particle minecraft:bubble {x} -43 {z} 0.7 0 0.7 0.3 75 normal
/particle minecraft:snowflake {x} -44 {z} 0.7 0 0.7 0.1 75 normal


#file: ./docks/summon/spawn_dock
/kill @e[tag=calledBoat]
/particle minecraft:bubble_pop -155 -43.5 122 1 0 1 0.2 100 normal
/summon minecraft:spruce_boat -155 -52.286 122 {Motion:[0.0,3.5,0.0],Tags:["calledBoat"],Invulnerable:1}


#file: ./docks/complete/spawn_dock
dock_state spawn_dock = 2
/setblock -154 -43 124 air
/setblock -154 -41 124 air
/setblock -153 -43 123 air
/setblock -153 -41 123 air
/setblock -154 -43 125 air
/setblock -154 -41 125 air
/setblock -154 -42 125 air
/setblock -154 -42 124 air
/setblock -153 -42 123 air


