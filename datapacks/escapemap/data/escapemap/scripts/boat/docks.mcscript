#file: ./docks/use_horn
//horn listener for spawn_dock
at(@s){
if('entity @e[tag=boat_marker,tag=spawn_dock,limit=1,distance=..8]') {
if(dock_state spawn_dock == 0) {
/function escapemap:boat/docks/call_boat/spawn_dock
}}}
//horn listener for lighthouse_dock
at(@s){
if('entity @e[tag=boat_marker,tag=lighthouse_dock,limit=1,distance=..8]') {
if(dock_state lighthouse_dock == 0) {
/function escapemap:boat/docks/call_boat/lighthouse_dock
}}}
//horn listener for jungle_dock
at(@s){
if('entity @e[tag=boat_marker,tag=jungle_dock,limit=1,distance=..5]') {
if(dock_state jungle_dock == 0) {
/function escapemap:boat/docks/call_boat/jungle_dock
}}}


