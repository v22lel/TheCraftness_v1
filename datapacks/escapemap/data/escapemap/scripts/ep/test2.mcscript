var ep_test2_progress

#file: ./test2/reset
/function escapemap:ep/test2/kill
/function escapemap:ep/test2/summon0
ep_test2_progress P = 0

#file: ./test2/kill
/kill @e[tag=ep_ia_test2]

#file: ./test2/summon0
/summon interaction -170 -3 278 {Tags:["ep_ia_test2", "0"],height:1.1f,width:1.1f}

#file: ./test2/tick
/execute as @e[tag=ep_ia_test2,tag=0] if data entity @s {interaction:{}} run function escapemap:ep/test2/click_0
/execute as @e[tag=ep_ia_test2,tag=1] if data entity @s {interaction:{}} run function escapemap:ep/test2/click_1
/execute as @e[tag=ep_ia_test2,tag=2] if data entity @s {interaction:{}} run function escapemap:ep/test2/click_2
/execute as @e[tag=ep_ia_test2,tag=3] if data entity @s {interaction:{}} run function escapemap:ep/test2/click_3
/execute as @e[tag=ep_ia_test2,tag=4] if data entity @s {interaction:{}} run function escapemap:ep/test2/click_4
/execute as @e[tag=ep_ia_test2,tag=5] if data entity @s {interaction:{}} run function escapemap:ep/test2/click_5
/execute as @e[tag=ep_ia_test2,tag=6] if data entity @s {interaction:{}} run function escapemap:ep/test2/click_6
/execute as @e[tag=ep_ia_test2,tag=7] if data entity @s {interaction:{}} run function escapemap:ep/test2/click_7
/execute as @e[tag=ep_ia_test2,tag=8] if data entity @s {interaction:{}} run function escapemap:ep/test2/click_8
/execute as @e[tag=ep_ia_test2,tag=9] if data entity @s {interaction:{}} run function escapemap:ep/test2/click_9
/execute as @e[tag=ep_ia_test2,tag=10] if data entity @s {interaction:{}} run function escapemap:ep/test2/click_10
/execute if score P ep_test2_progress matches 0..10 run function escapemap:ep/test2/particle_0
/execute if score P ep_test2_progress matches 1..10 run function escapemap:ep/test2/particle_1
/execute if score P ep_test2_progress matches 2..10 run function escapemap:ep/test2/particle_2
/execute if score P ep_test2_progress matches 3..10 run function escapemap:ep/test2/particle_3
/execute if score P ep_test2_progress matches 4..10 run function escapemap:ep/test2/particle_4
/execute if score P ep_test2_progress matches 5..10 run function escapemap:ep/test2/particle_5
/execute if score P ep_test2_progress matches 6..10 run function escapemap:ep/test2/particle_6
/execute if score P ep_test2_progress matches 7..10 run function escapemap:ep/test2/particle_7
/execute if score P ep_test2_progress matches 8..10 run function escapemap:ep/test2/particle_8
/execute if score P ep_test2_progress matches 9..10 run function escapemap:ep/test2/particle_9
/execute if score P ep_test2_progress matches 10..10 run function escapemap:ep/test2/particle_10

#file: ./test2/complete
/say complete
/function escapemap:ep/test2/kill

#file: ./test2/click_0
/execute as @e[tag=ep_ia_test2,tag=0] run data remove entity @s interaction
/kill @e[tag=ep_ia_test2,tag=1]
/kill @e[tag=ep_ia_test2,tag=2]
/kill @e[tag=ep_ia_test2,tag=3]
/kill @e[tag=ep_ia_test2,tag=4]
/kill @e[tag=ep_ia_test2,tag=5]
