/kill @e[tag=ep_ia_test2,tag=10]
/summon interaction -162 -3 278 {Tags:["ep_ia_test2", "1"],height:1.1f,width:1.1f}
/scoreboard players set P ep_test2_progress 1
/execute if score P ep_test2_progress matches 11 run function escapemap:ep/test2/complete

