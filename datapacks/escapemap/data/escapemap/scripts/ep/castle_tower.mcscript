var ep_castle_tower_progress

#file: ./castle_tower/reset
/function escapemap:ep/castle_tower/kill
/function escapemap:ep/castle_tower/summon0
ep_castle_tower_progress P = 0

#file: ./castle_tower/kill
/kill @e[tag=ep_ia_castle_tower]

#file: ./castle_tower/summon0
/summon interaction -166 -18 -47 {Tags:["ep_ia_castle_tower", "0"],height:1.1f,width:1.1f}

#file: ./castle_tower/tick
/execute as @e[tag=ep_ia_castle_tower,tag=0] if data entity @s {interaction:{}} run function escapemap:ep/castle_tower/click_0
/execute as @e[tag=ep_ia_castle_tower,tag=1] if data entity @s {interaction:{}} run function escapemap:ep/castle_tower/click_1
/execute as @e[tag=ep_ia_castle_tower,tag=2] if data entity @s {interaction:{}} run function escapemap:ep/castle_tower/click_2
/execute as @e[tag=ep_ia_castle_tower,tag=3] if data entity @s {interaction:{}} run function escapemap:ep/castle_tower/click_3
/execute as @e[tag=ep_ia_castle_tower,tag=4] if data entity @s {interaction:{}} run function escapemap:ep/castle_tower/click_4
/execute as @e[tag=ep_ia_castle_tower,tag=5] if data entity @s {interaction:{}} run function escapemap:ep/castle_tower/click_5
/execute if score P ep_castle_tower_progress matches 0..5 run function escapemap:ep/castle_tower/particle_0
/execute if score P ep_castle_tower_progress matches 1..5 run function escapemap:ep/castle_tower/particle_1
/execute if score P ep_castle_tower_progress matches 2..5 run function escapemap:ep/castle_tower/particle_2
/execute if score P ep_castle_tower_progress matches 3..5 run function escapemap:ep/castle_tower/particle_3
/execute if score P ep_castle_tower_progress matches 4..5 run function escapemap:ep/castle_tower/particle_4
/execute if score P ep_castle_tower_progress matches 5..5 run function escapemap:ep/castle_tower/particle_5

#file: ./castle_tower/complete
/say complete
/function escapemap:ep/castle_tower/kill

#file: ./castle_tower/click_0
/execute as @e[tag=ep_ia_castle_tower,tag=0] run data remove entity @s interaction
/kill @e[tag=ep_ia_castle_tower,tag=1]
/kill @e[tag=ep_ia_castle_tower,tag=2]
/kill @e[tag=ep_ia_castle_tower,tag=3]
/kill @e[tag=ep_ia_castle_tower,tag=4]
/kill @e[tag=ep_ia_castle_tower,tag=5]
/summon interaction -160 -18 -47 {Tags:["ep_ia_castle_tower", "1"],height:1.1f,width:1.1f}
/scoreboard players set P ep_castle_tower_progress 1
/execute if score P ep_castle_tower_progress matches 6 run function escapemap:ep/castle_tower/complete

#file: ./castle_tower/click_1
/execute as @e[tag=ep_ia_castle_tower,tag=1] run data remove entity @s interaction
/kill @e[tag=ep_ia_castle_tower,tag=2]
/kill @e[tag=ep_ia_castle_tower,tag=3]
/kill @e[tag=ep_ia_castle_tower,tag=4]
/kill @e[tag=ep_ia_castle_tower,tag=5]
/summon interaction -160 -18 -53 {Tags:["ep_ia_castle_tower", "2"],height:1.1f,width:1.1f}
/scoreboard players set P ep_castle_tower_progress 2
/execute if score P ep_castle_tower_progress matches 6 run function escapemap:ep/castle_tower/complete

#file: ./castle_tower/click_2
/execute as @e[tag=ep_ia_castle_tower,tag=2] run data remove entity @s interaction
/kill @e[tag=ep_ia_castle_tower,tag=3]
/kill @e[tag=ep_ia_castle_tower,tag=4]
/kill @e[tag=ep_ia_castle_tower,tag=5]
/summon interaction -166 -18 -53 {Tags:["ep_ia_castle_tower", "3"],height:1.1f,width:1.1f}
/scoreboard players set P ep_castle_tower_progress 3
/execute if score P ep_castle_tower_progress matches 6 run function escapemap:ep/castle_tower/complete

#file: ./castle_tower/click_3
/execute as @e[tag=ep_ia_castle_tower,tag=3] run data remove entity @s interaction
/kill @e[tag=ep_ia_castle_tower,tag=4]
/kill @e[tag=ep_ia_castle_tower,tag=5]
/summon interaction -166 -18 -50 {Tags:["ep_ia_castle_tower", "4"],height:1.1f,width:1.1f}
/scoreboard players set P ep_castle_tower_progress 4
/execute if score P ep_castle_tower_progress matches 6 run function escapemap:ep/castle_tower/complete

#file: ./castle_tower/click_4
/execute as @e[tag=ep_ia_castle_tower,tag=4] run data remove entity @s interaction
/kill @e[tag=ep_ia_castle_tower,tag=5]
/summon interaction -164 -18 -50 {Tags:["ep_ia_castle_tower", "5"],height:1.1f,width:1.1f}
/scoreboard players set P ep_castle_tower_progress 5
/execute if score P ep_castle_tower_progress matches 6 run function escapemap:ep/castle_tower/complete

#file: ./castle_tower/click_5
/execute as @e[tag=ep_ia_castle_tower,tag=5] run data remove entity @s interaction
/scoreboard players set P ep_castle_tower_progress 6
/execute if score P ep_castle_tower_progress matches 6 run function escapemap:ep/castle_tower/complete

